NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only. Required only for trusted backend operations that explicitly need it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Server-only. Required for approved member onboarding invites.
MEMBER_INVITE_REDIRECT_URL=http://localhost:3000/auth/callback?next=/reset-password

# Server-only. Required for existing-user password recovery.
PASSWORD_RESET_REDIRECT_URL=http://localhost:3000/auth/callback?next=/reset-password
